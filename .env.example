# Скопіюй у .env і заповни. Сам .env у git не потрапляє (див. .gitignore).
#   cp .env.example .env
#
# У IntelliJ: Run Configuration -> Environment variables -> шлях до .env
# (плагін EnvFile) або просто пропиши їх у конфігурації запуску.

# ---------- Інфраструктура (збігається з docker-compose.yml) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tp
POSTGRES_PASSWORD=tp

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ---------- JWT ----------
# Згенеруй пару ключів RS256 один раз:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out infra/keys/jwt-private.pem
#   openssl rsa -pubout -in infra/keys/jwt-private.pem -out infra/keys/jwt-public.pem
# Тека infra/keys/ має бути в .gitignore (шаблон *.pem уже є).
JWT_PRIVATE_KEY_LOCATION=file:infra/keys/jwt-private.pem
JWT_PUBLIC_KEY_LOCATION=file:infra/keys/jwt-public.pem
JWT_ISSUER=http://localhost:8081
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# ---------- Ключі провайдерів ----------
# Реєструйся поступово: для першого місяця потрібен тільки Geoapify.
# Open-Meteo ключа не потребує.
GEOAPIFY_API_KEY=
ORS_API_KEY=
OPENTRIPMAP_API_KEY=

# Другий місяць
GRAPHHOPPER_API_KEY=

# Пізніше
NEWSDATA_API_KEY=
TICKETMASTER_API_KEY=
API_NINJAS_KEY=

# ---------- Квоти провайдерів ----------
# Ці числа йдуть напряму в конфіг Resilience4j RateLimiter.
# Тримай їх тут, щоб не шукати по коду, коли зміниться тариф.
GEOAPIFY_DAILY_LIMIT=3000
OPENMETEO_DAILY_LIMIT=10000
NOMINATIM_RATE_PER_SECOND=1
TICKETMASTER_DAILY_LIMIT=5000
NEWSDATA_DAILY_LIMIT=200

# ---------- SerpAPI (Google Flights / Google Hotels) ----------
# 100 пошуків/міс безкоштовно; реєстрація serpapi.com. Без ключа
# ендпоінти /api/flights і /api/hotels повертають 503 (сервіс живе).
SERPAPI_API_KEY=
SERPAPI_DEFAULT_CURRENCY=EUR

# ---------- Google Sign-In ----------
# Web OAuth 2.0 Client ID з Google Cloud Console (той самий проєкт, що й Maps).
# Публічний — його ж треба вписати у frontend/web/src/environments/environment.ts.
# Порожній → кнопка Google не показується, звичайний вхід працює.
GOOGLE_OAUTH_CLIENT_ID=
