# Скопіюй у deploy/.env на сервері й заповни. Сам .env у git не потрапляє.
#
#   cp deploy/.env.example deploy/.env && nano deploy/.env

# ---------- Домен ----------
# Має вказувати A-записом на IP сервера ДО першого запуску: Caddi потрібен
# робочий домен, щоб отримати сертифікат Let's Encrypt.
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# ---------- Образи ----------
# Власник пакетів у GHCR — зазвичай твій логін на GitHub (малими літерами).
GHCR_OWNER=mnjkpf
# Яку версію образів запускати. latest — остання з main; для відкату постав тег.
WAYLO_TAG=latest

# ---------- Бази ----------
POSTGRES_USER=waylo
# Згенеруй: openssl rand -base64 24
POSTGRES_PASSWORD=

# ---------- Обʼєктне сховище ----------
# Мають збігатися з infra/seaweedfs/s3.json
S3_ACCESS_KEY=waylo
S3_SECRET_KEY=waylo-local-secret

# ---------- Ключі провайдерів ----------
# Без них відповідна фіча просто вимикається, решта працює.
GEOAPIFY_API_KEY=
SERPAPI_API_KEY=
SERPAPI_DEFAULT_CURRENCY=EUR
GOOGLE_OAUTH_CLIENT_ID=
