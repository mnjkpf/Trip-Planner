# Образ для прода: приймає вже зібраний jar і більше нічого не робить.
#
# Навіщо окремо від Dockerfile сервісу: той збирає jar усередині образу, і під
# ARM така збірка в CI йшла б через емуляцію — десять хвилин на сервіс. Java
# байт-код від архітектури не залежить, тож jar збирається на звичайному
# x86-ранері, а сюди лише копіюється. Жодного RUN — отже, емуляція не потрібна
# взагалі, і arm64-образ складається за секунди.
FROM eclipse-temurin:21-jre

WORKDIR /app
COPY app.jar app.jar

# MaxRAMPercentage, а не -Xmx: ліміт пам'яті задає docker, а JVM бере частку від
# нього. SerialGC для куп до ~500 МБ дешевший за G1 і не тримає зайвих потоків —
# на двоядерній машині з вісьмома сервісами це помітно.
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70 -XX:+UseSerialGC -Xss512k"

ENTRYPOINT ["java", "-jar", "app.jar"]
